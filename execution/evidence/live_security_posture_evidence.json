    "announcements": [
      {
        "policyname": "Manage announcements",
        "permissive": "PERMISSIVE",
        "roles": "{public}",
        "cmd": "UPDATE",
        "qual": "(is_officer() OR (author_id = ( SELECT members.id\n   FROM members\n  WHERE (members.user_id = auth.uid()))))",
        "with_check": null
      },
      {
        "policyname": "Officers create announcements",
        "permissive": "PERMISSIVE",
        "roles": "{public}",
        "cmd": "INSERT",
        "qual": null,
        "with_check": "is_officer()"
      },
      {
        "policyname": "Officers delete announcements",
        "permissive": "PERMISSIVE",
        "roles": "{public}",
        "cmd": "DELETE",
        "qual": "is_officer()",
        "with_check": null
      },
      {
        "policyname": "View announcements",
        "permissive": "PERMISSIVE",
        "roles": "{public}",
        "cmd": "SELECT",
        "qual": "((category = 'General'::text) OR (is_pinned = true) OR (target_role = 'member'::user_role) OR ((target_role = 'officer'::user_role) AND is_officer()) OR ((target_role = 'admin'::user_role) AND is_admin()))",
        "with_check": null
      }
    ],
    "attendance": [
      {
        "policyname": "Admins delete attendance",
        "permissive": "PERMISSIVE",
        "roles": "{public}",
        "cmd": "DELETE",
        "qual": "is_admin()",
        "with_check": null
      },
      {
        "policyname": "Members view their own attendance, officers view all",
        "permissive": "PERMISSIVE",
        "roles": "{public}",
        "cmd": "SELECT",
        "qual": "((member_id = ( SELECT members.id\n   FROM members\n  WHERE (members.user_id = auth.uid()))) OR is_officer())",
        "with_check": null
      },
      {
        "policyname": "Officers update attendance",
